+    def _xfa_form_paths(self):
+        """Căile câmpurilor din șablonul XFA al PDF-ului D394 (cum leagă Adobe datele)."""
+        try:
+            import pypdf
+        except ImportError:
+            self.skipTest("pypdf indisponibil")
+        profile = _profile_registry.get_anaf_profile("D394", fields.Date.today())
+        with file_open(profile["pdf_file"], "rb") as f, mute_logger("pypdf._reader"):
+            xfa = pypdf.PdfReader(io.BytesIO(f.read())).trailer["/Root"]["/AcroForm"]["/XFA"]
+        template = next(xfa[i + 1].get_object().get_data() for i in range(0, len(xfa), 2) if xfa[i] == "template")
+        paths = set()
+
+        def walk(node, path):
+            for child in node:
+                if not isinstance(child.tag, str):
+                    continue
+                kind = etree.QName(child).localname
+                if kind not in ("subform", "subformSet", "field", "exclGroup", "area"):
+                    continue
+                name = child.get("name") if kind != "area" else None
+                child_path = f"{path}/{name}" if name else path
+                if name:
+                    paths.add(child_path)
+                walk(child, child_path)
+
+        walk(etree.fromstring(template), "")
+        return paths
+
+    @staticmethod
+    def _xdp_data_paths(xdp_content):
+        """Căile elementelor din `xfa:data` (ex. `/form1/tip1/sub1/sub2/cuiP`)."""
+        paths = set()
+
+        def walk(node, path):
+            for child in node:
+                if isinstance(child.tag, str):
+                    child_path = f"{path}/{etree.QName(child).localname}"
+                    paths.add(child_path)
+                    walk(child, child_path)
+
+        walk(etree.fromstring(xdp_content).find(".//{http://www.xfa.org/schema/xfa-data/1.0/}data"), "")
+        return paths
+
